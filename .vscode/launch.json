{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "msedge",
      "request": "launch",
      "name": "Launch Edge against localhost",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Node",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/main.tsx"
    }
  ]
}
